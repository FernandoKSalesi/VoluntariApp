generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id                   Int           @id @default(autoincrement())
  nome                 String
  email                String        @unique
  telefone             String?
  cpf                  String?       @unique
  username             String        @unique
  senha_hash           String
  eventosOrganizados   Evento[]      @relation("EventosOrganizados")
  inscricoes           Inscricao[]
  notificacoesEnviadas Notificacao[] @relation("NotificacaoRemetente")
  notificacoes         Notificacao[] @relation("NotificacaoDestinatario")

  @@map("usuarios")
}

model Evento {
  id             Int               @id @default(autoincrement())
  organizador_id Int
  nome           String
  descricao      String?           @db.Text
  horario_inicio DateTime
  horario_fim    DateTime
  localizacao    String?
  imagem_url     String?
  vagas_totais   Int
  criado_em      DateTime          @default(now())
  organizador    Usuario           @relation("EventosOrganizados", fields: [organizador_id], references: [id])
  categorias     EventoCategoria[]
  inscricoes     Inscricao[]
  notificacoes   Notificacao[]

  @@index([organizador_id], map: "eventos_organizador_id_fkey")
  @@map("eventos")
}

model Inscricao {
  id           Int             @id @default(autoincrement())
  usuario_id   Int
  evento_id    Int
  status       StatusInscricao @default(PENDENTE)
  inscrito_em  DateTime        @default(now())
  cancelado_em DateTime?
  evento       Evento          @relation(fields: [evento_id], references: [id])
  usuario      Usuario         @relation(fields: [usuario_id], references: [id])

  @@index([evento_id], map: "inscricoes_evento_id_fkey")
  @@index([usuario_id], map: "inscricoes_usuario_id_fkey")
  @@map("inscricoes")
}

model Notificacao {
  id           Int      @id @default(autoincrement())
  evento_id    Int?
  usuario_id   Int
  remetente_id Int?
  titulo       String
  mensagem     String   @db.Text
  lida         Boolean  @default(false)
  enviado_em   DateTime @default(now())
  evento       Evento?  @relation(fields: [evento_id], references: [id])
  remetente    Usuario? @relation("NotificacaoRemetente", fields: [remetente_id], references: [id])
  destinatario Usuario  @relation("NotificacaoDestinatario", fields: [usuario_id], references: [id])

  @@index([evento_id], map: "notificacoes_evento_id_fkey")
  @@index([remetente_id], map: "notificacoes_remetente_id_fkey")
  @@index([usuario_id], map: "notificacoes_usuario_id_fkey")
  @@map("notificacoes")
}

model Categoria {
  id        Int               @id @default(autoincrement())
  nome      String
  descricao String?           @db.Text
  eventos   EventoCategoria[]

  @@map("categorias")
}

model EventoCategoria {
  evento_id    Int
  categoria_id Int
  categoria    Categoria @relation(fields: [categoria_id], references: [id])
  evento       Evento    @relation(fields: [evento_id], references: [id])

  @@id([evento_id, categoria_id])
  @@index([categoria_id], map: "eventos_categorias_categoria_id_fkey")
  @@map("eventos_categorias")
}

enum StatusInscricao {
  PENDENTE
  CONFIRMADA
  CANCELADA
}
