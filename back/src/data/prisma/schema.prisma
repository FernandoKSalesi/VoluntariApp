generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                   Int           @id @default(autoincrement())
  name                 String        @map("nome")
  email                String        @unique
  phone                String?       @map("telefone")
  cpf                  String?       @unique
  username             String        @unique
  passwordHash         String        @map("senha_hash")
  organizedEvents      Event[]       @relation("OrganizedEvents")
  subscriptions        Subscription[]
  notificationsSent    Notification[] @relation("NotificationSender")
  notifications        Notification[] @relation("NotificationRecipient")

  @@map("usuarios")
}

model Event {
  id             Int               @id @default(autoincrement())
  organizerId    Int               @map("organizador_id")
  name           String            @map("nome")
  description    String?           @db.Text @map("descricao")
  startTime      DateTime          @map("horario_inicio")
  endTime        DateTime          @map("horario_fim")
  location       String?           @map("localizacao")
  imageUrl       String?           @map("imagem_url")
  totalSpots     Int               @map("vagas_totais")
  createdAt      DateTime          @default(now()) @map("criado_em")
  organizer      User              @relation("OrganizedEvents", fields: [organizerId], references: [id])
  categories     EventCategory[]
  subscriptions  Subscription[]
  notifications  Notification[]

  @@index([organizerId], map: "eventos_organizador_id_fkey")
  @@map("eventos")
}

model Subscription {
  id           Int             @id @default(autoincrement())
  userId       Int             @map("usuario_id")
  eventId      Int             @map("evento_id")
  status       SubscriptionStatus @default(PENDING)
  subscribedAt DateTime        @default(now()) @map("inscrito_em")
  canceledAt   DateTime?       @map("cancelado_em")
  event        Event           @relation(fields: [eventId], references: [id])
  user         User            @relation(fields: [userId], references: [id])

  @@index([eventId], map: "inscricoes_evento_id_fkey")
  @@index([userId], map: "inscricoes_usuario_id_fkey")
  @@map("inscricoes")
}

model Notification {
  id           Int      @id @default(autoincrement())
  eventId      Int?     @map("evento_id")
  userId       Int      @map("usuario_id")
  senderId     Int?     @map("remetente_id")
  title        String   @map("titulo")
  message      String   @db.Text @map("mensagem")
  read         Boolean  @default(false) @map("lida")
  sentAt       DateTime @default(now()) @map("enviado_em")
  event        Event?   @relation(fields: [eventId], references: [id])
  sender       User?    @relation("NotificationSender", fields: [senderId], references: [id])
  recipient    User     @relation("NotificationRecipient", fields: [userId], references: [id])

  @@index([eventId], map: "notificacoes_evento_id_fkey")
  @@index([senderId], map: "notificacoes_remetente_id_fkey")
  @@index([userId], map: "notificacoes_usuario_id_fkey")
  @@map("notificacoes")
}

model Category {
  id        Int               @id @default(autoincrement())
  name      String            @map("nome")
  description String?           @db.Text @map("descricao")
  events    EventCategory[]

  @@map("categorias")
}

model EventCategory {
  eventId      Int @map("evento_id")
  categoryId   Int @map("categoria_id")
  category     Category @relation(fields: [categoryId], references: [id])
  event        Event    @relation(fields: [eventId], references: [id])

  @@id([eventId, categoryId])
  @@index([categoryId], map: "eventos_categorias_categoria_id_fkey")
  @@map("eventos_categorias")
}

enum SubscriptionStatus {
  PENDING
  CONFIRMED
  CANCELED
}
